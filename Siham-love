<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SIHAM ❤️</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #000;
  overflow: hidden;
  width: 100%;
  height: 100vh;
  height: 100dvh;
  font-family: monospace;
}

canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.name {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #ffb6d9;
  font-size: clamp(25px, 7vw, 36px);
  font-family: cursive;
  text-align: center;
  text-shadow: 0 0 10px #ff007f, 0 0 30px #ff007f;
  opacity: 0;
  animation: show 2s forwards 2s;
  white-space: nowrap;
  pointer-events: none;
}

.love {
  margin-top: 15px;
  font-size: clamp(21px, 6vw, 29px);
  color: #ff168f;
  font-family: cursive;
  text-shadow: 0 0 10px #ff0088, 0 0 25px #ff0088;
}

@keyframes show {
  to { opacity: 1; }
}
</style>
</head>

<body>

<canvas id="c"></canvas>

<div class="name">
  SIHAM ❤️
  <div class="love">I Love You ❤️</div>
</div>

<script>
const c = document.getElementById("c");
const ctx = c.getContext("2d");

let w, h, particles = [];
let scale, cx, cy;

function resize() {
  const dpr = Math.min(window.devicePixelRatio || 1, 2);

  w = window.innerWidth;
  h = window.innerHeight;

  c.width = w * dpr;
  c.height = h * dpr;

  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  scale = Math.min(w, h) / 40;
  cx = w / 2;
  cy = h / 2;
}

function point(t) {
  return {
    x: 16 * Math.pow(Math.sin(t), 3),
    y: -(13 * Math.cos(t)
      - 5 * Math.cos(2 * t)
      - 2 * Math.cos(3 * t)
      - Math.cos(4 * t))
  };
}

function createParticles() {
  particles = [];

  for (let i = 0; i < 700; i++) {
    particles.push({
      t: Math.random() * Math.PI * 2,
      spread: (Math.random() - 0.5) * 2,
      x: Math.random() * w,
      y: Math.random() * h,
      speed: 0.001 + Math.random() * 0.003,
      char: Math.random() < 0.5 ? "0" : "1"
    });
  }
}

function draw() {
  ctx.clearRect(0, 0, w, h);

  const pulse = 1 + Math.sin(Date.now() * 0.002) * 0.035;

  particles.forEach((a, i) => {
    const p = point(a.t);

    const tx = cx + p.x * scale * pulse;
    const ty = cy + p.y * scale * pulse;

    a.x += (tx - a.x) * 0.045;
    a.y += (ty - a.y) * 0.045;

    a.t += a.speed;

    ctx.fillStyle = i % 3 === 0 ? "#ff65c5" : "#ff168f";
    ctx.shadowColor = "#ff0088";
    ctx.shadowBlur = 8;
    ctx.font = "12px monospace";

    ctx.fillText(a.char, a.x + a.spread, a.y);
  });

  ctx.shadowBlur = 0;
  requestAnimationFrame(draw);
}

window.addEventListener("resize", () => {
  resize();
});

resize();
createParticles();
draw();
</script>

</body>
</html>
