import pygame
import math
import random

pygame.init()
W, H = 900, 650
screen = pygame.display.set_mode((W, H))
pygame.display.set_caption("My chicken siham")
clock = pygame.time.Clock()

# --- 1. Points dyal l-9alb ---
targets = []
for _ in range(1200):
    t = random.uniform(0, 2 * math.pi)
    x = 16 * math.sin(t)**3
    y = 13 * math.cos(t) - 5 * math.cos(2*t) - 2 * math.cos(3*t) - math.cos(4*t)
    targets.append([W//2 + x * 15, H//2 + 30 - y * 15])

# --- 2. Points dyal l-ktba jdida ---
font = pygame.font.SysFont("serif", 55, bold=True, italic=True)
# Had l-ktba li bghiti
text_surf = font.render("My chicken siham", True, (255,255,255))
for y in range(text_surf.get_height()):
    for x in range(text_surf.get_width()):
        if text_surf.get_at((x,y)).a > 100 and random.random() < 0.35:
            targets.append([W//2 - text_surf.get_width()//2 + x, 55 + y])

# 9alb sghir 7da l-ktba
font2 = pygame.font.SysFont("seguiemojis", 50)
# Ila ma khdemch l-emoji, ghadi yban 9alb b l-khat
try:
    heart_surf = font2.render("❤️", True, (255,0,0))
    for y in range(heart_surf.get_height()):
        for x in range(heart_surf.get_width()):
            if heart_surf.get_at((x,y)).a > 100 and random.random() < 0.5:
                targets.append([W//2 + 230 + x, 50 + y])
except:
    pass

class Particle:
    def __init__(self, target):
        self.x = random.randint(0, W)
        self.y = random.randint(0, H)
        self.tx, self.ty = target
        self.speed = random.uniform(0.02, 0.06)
        self.size = random.randint(1, 3)
        self.color = random.choice([(255,182,193), (255,105,180), (255,255,255), (255,0,100)])

    def update(self):
        self.x += (self.tx - self.x) * self.speed
        self.y += (self.ty - self.y) * self.speed
        self.x += random.uniform(-0.5, 0.5)
        self.y += random.uniform(-0.5, 0.5)

    def draw(self, surf):
        pygame.draw.circle(surf, self.color, (int(self.x), int(self.y)), self.size)

particles = [Particle(t) for t in targets]
stars = [(random.randint(0,W), random.randint(0,H)) for _ in range(150)]

running = True
while running:
    for e in pygame.event.get():
        if e.type == pygame.QUIT:
            running = False

    screen.fill((10, 0, 20))
    for sx, sy in stars:
        pygame.draw.circle(screen, (100,100,140), (sx, sy), 1)

    for p in particles:
        p.update()
        p.draw(screen)

    pygame.display.flip()
    clock.tick(60)

pygame.quit()
